{
  "name": "neteoc",
  "version": "0.0.0",
  "private": true,
  "description": "Network Enhanced Operations Center",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.3 <2"
  },
  "scripts": {
    "prepare": "bun run --bun husky",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node node_modules/wrangler/bin/wrangler.js dev",
    "types:worker": "node node_modules/wrangler/bin/wrangler.js types",
    "check:astro": "astro check",
    "format": "bun run --bun prettier --write .",
    "format:check": "bun run --bun prettier --check .",
    "lint": "bun run --bun eslint . --max-warnings 0",
    "lint:docs": "bun scripts/lint-docs.mjs",
    "check:policy": "bun scripts/check-policy.mjs",
    "test": "bun test ./tests",
    "check": "bun run format:check && bun run lint && bun run lint:docs && bun run check:policy && bun run check:astro && bun run test && bun run build",
    "commitlint": "bun node_modules/@commitlint/cli/cli.js",
    "security:install": "python3 scripts/install-tools.py",
    "secrets:staged": "bun scripts/scan-secrets.mjs staged",
    "secrets:tree": "bun scripts/scan-secrets.mjs tree",
    "secrets:history": "bun scripts/scan-secrets.mjs history",
    "security:trivy": ".tools/bin/trivy fs --config trivy.yaml .",
    "security:semgrep": "semgrep scan --config .semgrep --error --strict --metrics off --disable-version-check --exclude tests/semgrep .",
    "staged": "bun run --bun lint-staged",
    "security:audit": "bun audit --audit-level high"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint": "0.41.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "wrangler": "4.150.0",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,astro}": [
      "bun run --bun eslint --max-warnings 0 --no-warn-ignored",
      "bun run --bun prettier --check"
    ],
    "*.{json,jsonc,yml,yaml,md,css,html,astro,ts,tsx}": "bun run --bun prettier --check",
    "*.md": "bun run lint:docs"
  },
  "packageManager": "bun@1.4.3",
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "astro": "7.3.8"
  }
}
