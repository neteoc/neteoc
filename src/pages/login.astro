---
const supabase = Astro.locals.supabase;
const error = Astro.url.searchParams.get('error');
const message =
  error === 'rate'
    ? 'Please wait before requesting another sign-in code.'
    : error === 'unavailable'
      ? 'Sign in is temporarily unavailable. Please try again later.'
      : 'We could not start sign in. Please try again.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Sign in | NetEOC</title>
  </head>
  <body>
    <main>
      <h1>Sign in</h1>
      {supabase ? (
        <>
          <p>Enter the email address associated with your invitation.</p>
          {error && <p role="alert">{message}</p>}
          <form method="post" action="/auth/login">
            <label for="email">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
            <button type="submit">Email a sign-in code</button>
          </form>
        </>
      ) : (
        <p>Sign in is unavailable until a Supabase project is configured.</p>
      )}
    </main>
  </body>
</html>
