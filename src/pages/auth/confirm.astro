---
import { env } from 'cloudflare:workers';
import {
  allowVerify,
  EMAIL_OTP_LENGTH,
  EMAIL_OTP_PATTERN,
  isValidEmailOtp,
  normalizeLoginEmail,
  readSmallForm,
} from '../../lib/login';

const errorCode = Astro.url.searchParams.get('error');
const errorMessage =
  errorCode === 'invalid'
    ? 'That code is invalid or has expired. Check the email and try again.'
    : errorCode === 'rate'
      ? 'Please wait before checking another sign-in code.'
      : errorCode === 'unavailable'
        ? 'Code verification is temporarily unavailable. Try again shortly.'
        : null;

if (Astro.request.method === 'POST') {
  const supabase = Astro.locals.supabase;
  if (!supabase)
    return new Response('Sign in is not configured', { status: 503 });

  const form = await readSmallForm(Astro.request);
  const email = form ? normalizeLoginEmail(form) : null;
  const tokens = form?.getAll('token') ?? [];
  if (!email || tokens.length !== 1 || !isValidEmailOtp(tokens[0])) {
    return Astro.redirect('/auth/confirm?error=invalid', 303);
  }

  try {
    if (!(await allowVerify(Astro.request, env))) {
      console.warn('auth_verify_rate_limited');
      return Astro.redirect('/auth/confirm?error=rate', 303);
    }
  } catch {
    console.error('auth_verify_limiter_unavailable');
    return Astro.redirect('/auth/confirm?error=unavailable', 303);
  }

  try {
    const { error } = await supabase.auth.verifyOtp({
      email,
      token: tokens[0],
      type: 'email',
    });
    if (error) {
      if (
        error.status === 0 ||
        error.status === 429 ||
        (error.status ?? 0) >= 500
      ) {
        console.error('auth_verify_provider_unavailable', {
          status: error.status,
          code: error.code,
        });
        return Astro.redirect('/auth/confirm?error=unavailable', 303);
      }
      return Astro.redirect('/auth/confirm?error=invalid', 303);
    }
  } catch {
    console.error('auth_verify_provider_unreachable');
    return Astro.redirect('/auth/confirm?error=unavailable', 303);
  }
  return Astro.redirect('/auth/set-password', 303);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Confirm sign in | NetEOC</title>
  </head>
  <body>
    <main>
      <h1>Verify your email</h1>
      <p>Enter the email address and code from your verification email.</p>
      {errorMessage && <p role="alert">{errorMessage}</p>}
      <form method="post" action="/auth/confirm">
        <label for="email">Email address</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
        />
        <label for="token">Verification code</label>
        <input
          id="token"
          name="token"
          inputmode="numeric"
          pattern={EMAIL_OTP_PATTERN}
          maxlength={EMAIL_OTP_LENGTH}
          required
        />
        <button type="submit">Continue to NetEOC</button>
      </form>
    </main>
  </body>
</html>
