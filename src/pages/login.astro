---
const supabase = Astro.locals.supabase;
const error = Astro.url.searchParams.get('error');
const message =
  error === 'rate'
    ? 'Please wait before trying to sign in again.'
    : error === 'unavailable'
      ? 'Sign in is temporarily unavailable. Please try again later.'
      : error === 'credentials'
        ? 'The email or password is incorrect.'
        : 'Please enter a valid email address and password.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Sign in | NetEOC</title>
  </head>
  <body>
    <main>
      <h1>Sign in</h1>
      {supabase ? (
        <>
          <p>Sign in with the email address associated with your invitation.</p>
          {error && <p role="alert">{message}</p>}
          <form method="post" action="/auth/login">
            <label for="email">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
            <label for="password">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
            />
            <button type="submit">Sign in</button>
          </form>
          <p>
            <a href="/auth/request-code">Set or reset your password</a>
          </p>
        </>
      ) : (
        <p>Sign in is unavailable until a Supabase project is configured.</p>
      )}
    </main>
  </body>
</html>
