---
import { readSmallForm } from '../../lib/login';

const supabase = Astro.locals.supabase;
if (!supabase) return Astro.redirect('/login', 303);
const { data: claims, error: claimsError } = await supabase.auth.getClaims();
if (claimsError || !claims?.claims) return Astro.redirect('/login', 303);

let message: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await readSmallForm(Astro.request);
  const passwords = form?.getAll('password') ?? [];
  const confirmations = form?.getAll('confirm_password') ?? [];
  const password = passwords[0];
  if (
    passwords.length !== 1 ||
    confirmations.length !== 1 ||
    password !== confirmations[0] ||
    !password ||
    password.length < 12 ||
    new TextEncoder().encode(password).byteLength > 1024
  ) {
    message = 'Use a matching password of at least 12 characters.';
  } else {
    try {
      const { error } = await supabase.auth.updateUser({ password });
      if (!error) return Astro.redirect('/app', 303);
      message = 'Could not save your password. Please try another password.';
    } catch {
      message = 'Password setup is temporarily unavailable. Please try again.';
    }
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Set password | NetEOC</title>
  </head>
  <body>
    <main>
      <h1>Set your password</h1>
      <p>Use at least 12 characters.</p>
      {message && <p role="alert">{message}</p>}
      <form method="post" action="/auth/set-password">
        <label for="password">New password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="new-password"
          minlength="12"
          required
        />
        <label for="confirm_password">Confirm new password</label>
        <input
          id="confirm_password"
          name="confirm_password"
          type="password"
          autocomplete="new-password"
          minlength="12"
          required
        />
        <button type="submit">Save password</button>
      </form>
    </main>
  </body>
</html>
